# ==============================================================================
# Gemini-Proxmox VE Operator Gateway — Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual environment values.
# ==============================================================================

# --- Public Hostname & Discovery ---
# The public HTTPS base URL for your gateway (e.g. routed via Cloudflare Tunnel).
# Used for OAuth 2.0 / OIDC metadata discovery and JWT issuer claims.
PUBLIC_BASE_URL=https://pve-mcp.example.com

# --- Proxmox VE Hypervisor API Credentials ---
# The IP address or hostname of your Proxmox VE node / cluster API.
PROXMOX_HOST=192.168.1.100
PROXMOX_PORT=8006
PROXMOX_USER=gemini-operator@pve
PROXMOX_TOKEN_NAME=operator
PROXMOX_TOKEN_VALUE=your-proxmox-api-token-secret-uuid
PROXMOX_VERIFY_SSL=false

# --- Storage Defaults ---
# Default storage pool for immediate vzdump backups (e.g. local, local-lvm, pbs-datastore)
PROXMOX_BACKUP_STORAGE=local

# --- Secret Capability Path & Gateway Security ---
# Static bearer secret for LAN/internal callers (e.g. local scripts, curl, agents)
GATEWAY_SECRET=generate-a-random-64-char-hex-secret-here

# Secret 128-bit cryptographic capability prefix for MCP endpoint
# Resulting endpoint: https://pve-mcp.example.com/<MCP_SECRET_PATH>/mcp
MCP_SECRET_PATH=mcp-generate-a-random-uuid-here

# --- OAuth 2.0 Credentials (Google Gemini Spark Connected Apps) ---
# Client ID and Client Secret configured in Gemini Custom Connected App settings.
OAUTH_CLIENT_ID=gemini-spark
OAUTH_CLIENT_SECRET=generate-a-strong-oauth-client-secret-here
# Optional: user email returned in OIDC userinfo (defaults to operator@<hostname>)
OAUTH_USER_EMAIL=operator@example.com

# --- Blast-Radius Safeguards ---
# List of VM/LXC IDs strictly shielded against stop, reboot, and shutdown actions.
# Protects your ingress tunnel container or critical infrastructure from accidental AI shutdown.
# Example: PROTECTED_VMIDS=[100, 101]
PROTECTED_VMIDS=[100]
